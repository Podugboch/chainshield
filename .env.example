# ---------------------------------------------------------------
# Web app (Vite). Anything prefixed VITE_ is compiled into the JS
# bundle and is therefore public. Never put a service-role key,
# a database password or a private API key here.
# ---------------------------------------------------------------

# Supabase. Optional -- the app falls back to browser-local storage without it.
# Apply supabase/schema.sql before connecting: the anon key is public, so the
# row-level-security policies in that file are the only access control there is.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Etherscan API key for richer wallet history. Without it the app uses
# public RPC endpoints and says which data it could not read.
VITE_ETHERSCAN_API_KEY=

# ---------------------------------------------------------------
# Forensics API (api/main.py). Server-side only -- these are read by
# uvicorn, not by the browser, and are not compiled into the bundle.
# All optional; the defaults shown are what the service uses.
# ---------------------------------------------------------------

# Comma-separated CORS allowlist. Defaults to local dev origins. Set this to your
# real front-end origin before deploying -- credentials are not accepted, but an
# open allowlist still lets any page call the service on a visitor's behalf.
CHAINSHIELD_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Sliding-window rate limit, per client.
CHAINSHIELD_RATE_LIMIT=30
CHAINSHIELD_RATE_WINDOW=60

# Per-RPC-call timeout, seconds.
CHAINSHIELD_UPSTREAM_TIMEOUT=6.0

# Successful response cache TTL, seconds. Pending transactions are never cached.
CHAINSHIELD_CACHE_TTL=120

# Set to 1 ONLY when running behind a reverse proxy you control. It makes the
# rate limiter trust X-Forwarded-For, which any client can otherwise forge to get
# a fresh quota on every request.
CHAINSHIELD_TRUST_PROXY=
